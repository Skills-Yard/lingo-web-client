<tr><td><code>hex.riv</code></td><td><code>ModuleBackground 2</code></td><td><code>State Machine 1</code></td><td>Level path background (repeated down the page)</td></tr>
<tr><td><code>hex.riv</code></td><td><code>REWARD_Chest</code></td><td><code>RewardChest_SM</code>; <code>RewardChest</code> trigger <code>open</code></td><td>Reward screen chest</td></tr>
